read R1
read R2
step:
  S3 += R1 .
  S3 /= R2 .
  R1 %= R2 .
  T3 += R1 .
  R1 -= R1 .
  R1 += R2 .
  R2 -= R2 .
  R2 += T3 .

  T3 -= T3 .
  T3 += S3 .
  S3 *= S2 .
  S3 += S1 .
  S1 -= S1 .
  S1 += S2 .
  S2 -= S2 .

  S2 += S3 .
  S3 -= S3 .
  T3 *= T2 .
  T3 += T1 .
  T1 -= T1 .
  T1 += T2 .

  T2 -= T2
  T2 += T3
  T3 -= T3
  F == 0
loop:
  X == R2
  add X 0 1
end:
  print R1 .
  print newline .
  add F to thing < doing this atm
  sub F from another
  print S1
  print T1
  halt


Variables and constants:
R1 - overwrites second cell of program?
R2 - overwrites first cell of program?
S1 = 1
S2 = 0
S3 = 0
T1 = 0
T2 = 1
T3/X/R3 = 0
F = 0
char -
char newline


Layout:

-->--------v
xxxv-------<
xxx>------v
xx^ ------<
.x>----  v
| v-<--< <
^-< <  ^-<
